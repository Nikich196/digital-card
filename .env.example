# PostgreSQL connection string used by Prisma at runtime.
DATABASE_URL="postgresql://card:card@localhost:5432/digital_card?schema=public"

# Direct connection, used for migrations. Behind a transaction pooler the two
# differ; against a plain PostgreSQL they are the same string. Prisma refuses to
# read the schema when this is missing, so it has to be set either way.
DIRECT_URL="postgresql://card:card@localhost:5432/digital_card?schema=public"

# HTTP port the application listens on.
PORT=3000

# Enables Apollo Sandbox and schema introspection. Keep "true" for the demo.
GRAPHQL_PLAYGROUND=true
